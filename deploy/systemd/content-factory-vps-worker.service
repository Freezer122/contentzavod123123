[Unit]
Description=Content Factory autonomous publishing worker (disarmed by default)
Wants=network-online.target content-factory-adspower.service postgresql.service redis-server.service
After=network-online.target content-factory-adspower.service postgresql.service redis-server.service

[Service]
User=contentfactory
Group=contentfactory
WorkingDirectory=/opt/content-factory/current
EnvironmentFile=/etc/content-factory/worker.env
ExecStart=/opt/content-factory/runtime/node-v22.23.5-linux-x64/bin/node /opt/content-factory/current/dist/main.js --worker
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/content-factory

[Install]
WantedBy=multi-user.target
