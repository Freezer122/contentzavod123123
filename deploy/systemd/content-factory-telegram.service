[Unit]
Description=Content Factory private Telegram control bot
Wants=network-online.target postgresql.service redis-server.service
After=network-online.target postgresql.service redis-server.service
StartLimitIntervalSec=0

[Service]
User=contentfactory
Group=contentfactory
WorkingDirectory=/opt/content-factory/current
EnvironmentFile=/etc/content-factory/worker.env
EnvironmentFile=/etc/content-factory-secrets/telegram.env
EnvironmentFile=/etc/content-factory/telegram.env
ExecStart=/usr/bin/flock -n /var/lib/content-factory/telegram-polling.lock /opt/content-factory/runtime/node-v22.23.5-linux-x64/bin/node /opt/content-factory/current/dist/main.js
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/content-factory

[Install]
WantedBy=multi-user.target
