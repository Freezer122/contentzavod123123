[Unit]
Description=Content Factory — Telegram and publishing
After=network-online.target docker.service graphical.target
Wants=network-online.target

[Service]
Type=simple
User=factory
Group=factory
WorkingDirectory=/opt/content-factory
EnvironmentFile=/opt/content-factory/.env
Environment=DISPLAY=:1
Environment=XAUTHORITY=/home/factory/.Xauthority
ExecStart=/usr/local/bin/node /opt/content-factory/dist/main.js
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/content-factory /home/factory

[Install]
WantedBy=graphical.target
