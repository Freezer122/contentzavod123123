[Unit]
Description=Content Factory PostgreSQL backup
[Service]
Type=oneshot
User=contentfactory
Group=contentfactory
WorkingDirectory=/opt/content-factory/current
EnvironmentFile=/etc/content-factory/worker.env
Environment=BACKUP_DIR=/var/lib/content-factory/backups/daily
Environment=BACKUP_KEEP_COUNT=7
ExecStart=/opt/content-factory/runtime/node-v22.23.5-linux-x64/bin/node /opt/content-factory/current/scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/content-factory/backups
