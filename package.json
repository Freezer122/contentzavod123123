{
  "name": "content-factory",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "demo": "tsx src/main.ts --demo",
    "build": "tsc -p tsconfig.build.json",
    "build:tools": "tsc -p tsconfig.tools.json",
    "start": "node dist/main.js",
    "worker": "node dist/main.js --worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate",
    "test:browser": "vitest run tests/browser.integration.test.ts",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "dry-run": "node --import tsx scripts/diagnose.ts",
    "probe:adspower": "node --import tsx scripts/probe-adspower.ts",
    "rehearse:worker": "node --import tsx scripts/rehearse-worker.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^5.63.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2",
    "grammy": "^1.38.3",
    "ioredis": "^5.8.2",
    "playwright": "^1.56.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
